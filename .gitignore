node_modules/
dist/
# package-lock.json IS committed: it pins every dependency (and its integrity
# hash) so a newly published malicious version can't reach a build. npm/cli#4828
# caveat: a lockfile rewritten from a platform-skewed node_modules can drop the
# other platforms' optional deps (e.g. the Yellowstone native binding). Update it
# only with `npm install --package-lock-only`, and check it still lists
# @triton-one/yellowstone-grpc-napi-linux-x64-musl before committing.
.env
.env.*
!.env.example
config.json
config.*.json
!config.example.json
/state/
*.log
terraform/.terraform/
# Any state, including per-workspace state under terraform.tfstate.d/.
# State can embed resource attributes and config; it is never committed.
**/*.tfstate*
terraform/terraform.tfstate.d/
terraform/terraform.tfvars.json
