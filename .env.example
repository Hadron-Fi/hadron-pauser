# Secrets are referenced from config.json via "env:NAME" — nothing secret goes
# in the config document itself.

# The pause-authority keypair (bs58 string or JSON byte array).
# OPERATOR-PROVIDED — this service never generates keys. Blast radius of this
# key is "can pause the pool", nothing else (one-way; cannot unpause/withdraw).
PAUSER_SECRET=

# Yellowstone gRPC auth (config.grpc.token: "env:GRPC_API_KEY")
GRPC_API_KEY=

# Optional: dead-man's-switch ping URL (healthchecks.io style)
HEARTBEAT_URL=

# Config document location (default ./config.json). On ECS the whole document
# is instead injected as CONFIG_JSON (see terraform/).
CONFIG_PATH=config.json

# Restart memory (optional but recommended): a small JSON snapshot holding the
# drawdown windows + the authority baseline, so restarts/deploys neither
# re-arm the drawdown budget nor miss authority changes that land while the
# process is down. Pick ONE backend; neither set = stateless fresh starts.
# The terraform module provisions the S3 bucket + task role automatically.
#STATE_PATH=./state/pauser.json
#STATE_S3_BUCKET=
#STATE_S3_KEY=hadron-pauser.json
#SNAPSHOT_INTERVAL_MS=60000
